        "template_id": "ST-SAAS-CREATE-RECORD",
        "title": "Create New Workspace Project",
        "objective": "Verify creating a project adds it to the visible project dashboard.",
        "category": "workflow",
        "steps": [
          {
            "step_number": 1,
            "action_type": "CLICK",
            "target_semantic": "new_project_button",
            "target_selector_hints": [
              "#new-project",
              "button:text('New Project')",
              ".create-btn"
            ],
            "description": "Click create project button"
          },
          {
            "step_number": 2,
            "action_type": "FILL",
            "target_semantic": "project_name_input",
            "target_selector_hints": [
              "#project-name",
              "input[name='name']"
            ],
            "input_value": "Automated QA Verification",
            "description": "Enter project name"
          },
          {
            "step_number": 3,
            "action_type": "CLICK",
            "target_semantic": "save_project_button",
            "target_selector_hints": [
              "#save-btn",
              "button[type='submit']"
            ],
            "assertion_type": "VISIBLE",
            "assertion_expected": "Automated QA Verification",
            "description": "Save new project"
          }
        ],
        "assertions": [
          {
            "type": "RECORD_IN_LIST",
            "expected": "Automated QA Verification"
          }
        ]
      }
    ],
    "negative_scenarios": [
      {
        "scenario_id": "NEG-SAAS-EMPTY-NAME",
        "title": "Create Record Blank Name Boundary",
        "objective": "Verify submitting empty project name triggers validation error.",
        "boundary_type": "MISSING_REQUIRED_FIELD",
        "invalid_input": {
          "name": ""
        },
        "expected_error_message_fragment": "Name is required"
      }
    ],
