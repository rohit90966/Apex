  {
    "pattern_id": "PAT-AUTH-LOGOUT-01",
    "name": "User Authentication Logout and Session Termination",
    "archetypes": [
      "AUTHENTICATION",
      "ECOMMERCE",
      "SAAS_CRUD",
      "BANKING_FINTECH"
    ],
    "capabilities": [
      "USER_AUTHENTICATION",
      "DRAWER_NAVIGATION"
    ],
    "description": "Clicking logout in the drawer menu resets user session and returns to login view.",
    "preconditions": [
      "Authenticated user session active",
      "On application page with navigation drawer"
    ],
    "risk_level": "LOW",
    "invariants": [
      "Logout clears authenticated session and returns to root / or /login"
    ],
    "scenario_templates": [
      {
        "template_id": "ST-AUTH-LOGOUT",
        "title": "Logout User Session Via Drawer",
        "objective": "Verify clicking logout clears active session and navigates back to login view.",
        "category": "workflow",
        "steps": [
          {
            "step_number": 1,
            "action_type": "CLICK",
            "target_semantic": "drawer_toggle",
            "target_selector_hints": [
              "#react-burger-menu-btn"
            ],
            "description": "Open drawer menu"
          },
          {
            "step_number": 2,
            "action_type": "CLICK",
            "target_semantic": "logout_link",
            "target_selector_hints": [
              "#logout_sidebar_link",
              "a#logout_sidebar_link",
              "a:text('Logout')"
            ],
            "expected_state_or_fragment": "/",
            "assertion_type": "VISIBLE",
            "assertion_expected": "Login",
            "description": "Click logout link"
          }
        ],
        "assertions": [
          {
            "type": "URL_EQUALS_LOGIN",
            "expected": "/"
          }
        ]
      }
    ],
    "negative_scenarios": [],
    "evidence_requirements": [
      "logout_button",
      "login_page"
    ],
