# Primary LLM Provider: "groq" (default), "gemini", or "ollama"
LLM_PROVIDER=groq

# Groq API Configuration (leave empty in example, set in local .env or environment)
GROQ_API_KEY=add your Groq API key here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Configuration (optional)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=200
LLM_MAX_RETRIES=2

# Optional Local Ollama Provider Configuration (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_PREDICT=1500
OLLAMA_NUM_CTX=4096

# VerityQA Runtime Configuration
VERITYQA_ARTIFACTS_DIR=artifacts
VERITYQA_HEADLESS=true
VERITYQA_MAX_TEST_CASES=15
VERITYQA_ALLOWED_HOSTS=127.0.0.1,localhost,saucedemo.com,www.saucedemo.com,https://sauce-demo.myshopify.com

# ── Website credential profiles ──────────────────────────────────────────────────────────────────────────
# One profile per website account: VERITYQA_CREDENTIALS_<PROFILE>_USERNAME / _PASSWORD / _ORIGIN.
# A profile is only used for the exact ORIGIN (scheme://host:port) it names; localhost and 127.0.0.1 differ.
# Local fixtures need ORIGIN (their port varies); SAUCEDEMO defaults to https://www.saucedemo.com.
# Optional per profile: _LOGIN_URL, and _USERNAME_SELECTOR/_PASSWORD_SELECTOR/_SUBMIT_SELECTOR only when a login
# page has several plausible forms. Values here are placeholders: put real ones in your local .env (git-ignored).
#
# VERITYQA_CREDENTIALS_SAUCEDEMO_USERNAME=your_username
# VERITYQA_CREDENTIALS_SAUCEDEMO_PASSWORD=your_password
#
# VERITYQA_CREDENTIALS_HARBOR_ORIGIN=http://localhost:8005
# VERITYQA_CREDENTIALS_HARBOR_USERNAME=your_username
# VERITYQA_CREDENTIALS_HARBOR_PASSWORD=your_password
#
# VERITYQA_CREDENTIALS_APEX_ORIGIN=http://127.0.0.1:8101
# VERITYQA_CREDENTIALS_APEX_USERNAME=your_username
# VERITYQA_CREDENTIALS_APEX_PASSWORD=your_password
#
# VERITYQA_CREDENTIALS_TASKDASH_ORIGIN=http://127.0.0.1:8102
# VERITYQA_CREDENTIALS_TASKDASH_USERNAME=your_username
# VERITYQA_CREDENTIALS_TASKDASH_PASSWORD=your_password
#
# VERITYQA_CREDENTIALS_BENCHMARK_SHOP_ORIGIN=http://127.0.0.1:8103
# VERITYQA_CREDENTIALS_BENCHMARK_SHOP_USERNAME=your_username
# VERITYQA_CREDENTIALS_BENCHMARK_SHOP_PASSWORD=your_password
#
# Reuse an authenticated session across the tests of one run (in memory only, per origin and profile): 1 (default) / 0
# VERITYQA_AUTH_SESSION_REUSE=1
#
# Legacy single-origin variables (still supported; read as a profile named TEST):
# VERITYQA_TEST_CREDENTIALS_ORIGIN=http://127.0.0.1:8003
# VERITYQA_TEST_USERNAME=
# VERITYQA_TEST_PASSWORD=

# Opt-in: let the LLM propose extra test scenarios (still validated against observed evidence; failures of
# LLM-proposed expectations are reported as anomalies, never as confirmed defects).
# VERITYQA_LLM_TEST_PROPOSALS=1

# Optional extra action-semantics keywords for the safety governor (comma-separated; can only add restrictions)
# VERITYQA_IRREVERSIBLE_ACTION_KEYWORDS=
# VERITYQA_TRANSACTION_COMMIT_KEYWORDS=
# VERITYQA_TRANSACTION_ENTRY_KEYWORDS=

# Local benchmark fixtures: VERITYQA_FIXTURE_MODE=baseline serves the defect-free build (default: planted bugs).
# VERITYQA_FIXTURE_DISCLOSE_BUGS=1 exposes the planted-bug manifest to evaluators only (never set it for agent runs).
